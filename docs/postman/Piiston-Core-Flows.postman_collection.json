{
  "info": {
    "name": "Piiston - Core Flows (Postman)",
    "description": "Functional testing collection for Piiston.\n\nRUN ORDER: 1) Auth > Login  2) Catalog > Brands/Models  3) Add Vehicle > Add vehicle  4) Garage Search > Search + branch services  5) Book Service  6) Send Assistant Alert.\n\nToken and IDs are captured automatically via test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api/auth/login}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Returns access_token. Token is auto-saved to the {{token}} variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Has access_token', function () { pm.expect(json.access_token).to.be.a('string'); });",
                  "if (json.access_token) { pm.environment.set('token', json.access_token); }",
                  "if (json.user && json.user.id) { pm.environment.set('user_id', json.user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (VEHICLE_OWNER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api/auth/register}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Role must be one of: VEHICLE_OWNER, GARAGE_OWNER, MECHANIC, SPARE_PART_SELLER, FLEET_MANAGER, ADMIN.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Tester\",\n  \"email\": \"postman.tester@example.com\",\n  \"phone\": \"+237690000001\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\",\n  \"country_id\": \"{{country_id}}\",\n  \"role\": \"VEHICLE_OWNER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('token', json.access_token);",
                  "} else { console.log('Register failed: ' + pm.response.text()); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Current User (me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api/auth/user}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "user"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Check Email Available",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api/auth/check-email}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "check-email"
              ]
            },
            "description": "422 = email already taken, 200 = available.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\"\n}"
            }
          }
        },
        {
          "name": "Check Phone Available",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api/auth/check-phone}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "check-phone"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+237690000002\"\n}"
            }
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api/auth/send-otp}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "send-otp"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+237690000002\"\n}"
            }
          }
        },
        {
          "name": "Verify OTP (use 123456)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api/auth/verify-otp}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-otp"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+237690000002\",\n  \"code\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api/auth/logout}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the current token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('token', '');"
                ]
              }
            }
          ]
        }
      ]
    },
