              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api/vehicles}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "vehicles"
              ]
            },
            "description": "Required: brand_id, model_id, year, license_plate, country_id, mileage. vin & photo optional. vin and license_plate must be UNIQUE. Expect 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand_id\": \"{{brand_id}}\",\n  \"model_id\": \"{{model_id}}\",\n  \"year\": 2022,\n  \"vin\": \"JTDBR32E830012345\",\n  \"license_plate\": \"{{license_plate}}\",\n  \"country_id\": \"{{country_id}}\",\n  \"mileage\": 45000,\n  \"color\": \"White\",\n  \"fuel_type_id\": \"{{fuel_type_id}}\",\n  \"transmission_id\": \"{{transmission_id}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Has vehicle id', function () { pm.expect(json.vehicle.id).to.exist; });",
                  "if (json.vehicle) { pm.environment.set('vehicle_id', json.vehicle.id); }"
                ]
              }
            }
          ]
