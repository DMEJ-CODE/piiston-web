              ],
              "path": [
                "api",
                "garages"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "Toyota",
                  "description": "Name/description contains"
                },
                {
                  "key": "country_id",
                  "value": "{{country_id}}",
                  "description": ""
                },
                {
                  "key": "status",
                  "value": "1",
                  "description": ""
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": ""
                }
              ]
            },
            "description": "Public (no auth). Filters: q, country_id, status, page. Paginated 15/page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length && json.data[0].id) { pm.environment.set('garage_id', json.data[0].id); }"
