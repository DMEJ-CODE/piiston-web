@startuml
' ============================================================================
' Piiston - Class Diagram (domain model)
' Laravel Eloquent models + key Flutter service/model classes.
' Sources: app/Models/**, app/Repositories/**, app/Policies/**,
'          lib/models/**, lib/services/**
' ============================================================================

title Piiston — Class Diagram (Domain + Mobile)

' ============================== BACKEND ====================================

package "<<identity>>\napp\\Models\\Identity" as PId {

  class User {
    -id : int
    -name : string <<accessor>> = "first_name last_name"
    -first_name : string
    -last_name : string
    -email : string
    -phone : string
    -password : string <<hashed>>
    -country_id : int
    -language_id : int
    -timezone_id : int
    -status : string = 'active'
    -profile_photo : string
    -date_of_birth : date
    -gender : string
    -last_login_at : datetime
    -phone_verified_at : datetime
    -email_verified_at : datetime
    --
    +hasRole(roleName : string) : bool
    +hasPermission(permissionName : string) : bool
    +initials() : string
    +getNameAttribute() : string
    +setNameAttribute(value) : void
  }

  enum Role {
    VEHICLE_OWNER
    GARAGE_OWNER
    MECHANIC
    SPARE_PART_SELLER
    FLEET_MANAGER
    ADMIN
  }

  class Permission {
    -name : string
    -module : string
    <<65 garage.* + vehicle.*\nrepair.manage · order.manage\nuser.verify>>
  }

  class Device <<HasApiTokens>> {
    -token : string <<unique>>
    -name : string
    -type : string
    -abilities : json
    -last_used_at : datetime
  }

  class UserAddress {
    -type : string
    -is_default : bool
  }

  class UserPreference {
    -country_id : int
    -currency_id : int
    -theme : string
    -language : string
    -notifications : json
  }

  class UserActivity {
    -type : string
    <<VEHICLE_ADDED · APPOINTMENT_BOOKED\nSOS_REQUESTED · ORDER_PLACED>>
  }
}

