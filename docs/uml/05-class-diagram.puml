package "<<services>>\napp\\Services (key state writers)" as PSvc {

  interface "PaymentProviderInterface" as PPI
  interface "AIProviderInterface" as PAI2
  interface "SearchProviderInterface" as PSI

  class RepairService {
    +createRepairOrder(data) : RepairOrder
    +submitDiagnosis(id, data)
    +submitEstimate(id, data)
    +approveEstimate(id)
    +updateStatus(id, status)
    +completeRepair(id)
    +performQualityCheck(id, data)
    +generateInvoice(id)
    +createRequest(data) : ServiceRequest
    +addTask(id, data) : RepairTask
    <color:#b00>#recordPayment() is CALLED by\nWeb\\RepairController:247 but\nDOES NOT EXIST -> fatal</color>
  }

  class PaymentService {
    +initialize(data) : PaymentTransaction
    +handleWebhook(reference, status)
    +normalizeStatus(status) : string
    +findByReference(ref) : PaymentTransaction
  }

  class WalletService {
    +getWallet(user) : Wallet
    +deposit(user, amount, ref)
    +withdraw(user, amount, ref)
  }

  class OrderService {
    +placeOrder(data) : Order
    +updateStatus(order, status)
  }

  class QuoteService {
    +submitQuote(data) : PartQuote
    +acceptQuote(quote) : Order
  }

  class ReceptionService {
    +completeReception(data) : VehicleCheckIn
    <color:#b00>seeds status_history on the\nnew RepairOrder; writes the\nsignature to disk FIRST</color>
  }
  class WarrantyService {
    +checkWarrantyCoverage(repair) : bool
    +resolveClaim(claim, resolution, approvedAmount)
    <color:#b00>checkWarrantyCoverage anchors on\nstatus=DELIVERED AND\nclosed_at > now()-6 months</color>
