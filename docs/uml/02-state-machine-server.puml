  end note
  PENDING --> PENDING : WarrantyClaimController::update():56\n<color:#b00>Request has no status rule\n -> status effectively IMMUTABLE via HTTP</color>
  RESOLVED --> [*]
}

' ----------------------------------------------------------------------------
' R. MESSAGING — Message / MessageStatus / UserPresence
' ----------------------------------------------------------------------------

state "Message" as MSG <<sdlReceive>> {
  [*] --> SENT : ChatEngine::sendMessage():49\nLivewire\Messaging\ChatCenter:74\nLivewire\Garage\RepairChat:77
  state SENT : status='SENT' (default)
  state DELIVERED
  state READ
  SENT --> DELIVERED : <color:#b00>[NO WRITER]</color>
  DELIVERED --> READ : <color:#b00>[NO WRITER on Message]</color>
  note right of MSG
    The designed home of the real machine is
    MessageStatus (message_statuses):
      message_id, user_id, status, timestamp
    written by MessageRepositoryInterface::markAsRead()
    ChatEngine::markAsRead():75-91 only
      - repo->markAsRead(lastMessage.id, Auth::id())
      - participants()->updateExistingPivot(
            Auth::id(), ['last_seen_message_id'=>...])
  end note
  SENT --> [*]
}

state "UserPresence" as UP <<sdlReceive>> {
  [*] --> OFFLINE
  state OFFLINE
  state ONLINE
  state BUSY
  OFFLINE --> ONLINE : <color:#b00>[NO WRITER in app/]</color>
  ONLINE --> BUSY : <color:#b00>[NO WRITER]</color>
  ONLINE --> OFFLINE : <color:#b00>[NO WRITER]</color>
  note right of UP
    The one route that touches it
    (POST /messaging/presence/status ->
     PresenceController::updateStatus)
    never persists the status column.
  end note
}

' ----------------------------------------------------------------------------
' S. NOTIFICATION (boolean machine)
' ----------------------------------------------------------------------------

state "Notification" as NT <<sdlReceive>> {
  [*] --> unread
  state unread : is_read = false
  state read : is_read = true, read_at = now()
  unread --> read : NotificationController::markAsRead()\nPOST notifications/{id}/read
  unread --> read : POST notifications/read-all
  read --> [*]
  note right of NT
    No 'status' column. Polymorphic link:
      reference_type in [RepairOrder, Order,
        EmergencyRequest, GarageAppointment,
        Conversation]
      reference_id
    + category: Repair | Marketplace | Message
    + priority: 'high' (EmergencyRequest:155)
  end note
}

