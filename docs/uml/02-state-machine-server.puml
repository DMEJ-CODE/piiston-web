  state "GaragePayment" as GP
  state "GarageInvoice" as GI
  state "RepairWarranty" as RW

  MA --> [*] : status='ASSIGNED' (default)\n<color:#b00>FULLY ORPHANED TABLE.\n MechanicService::getMyAssignments():57\n queries RepairOrder.assigned_mechanic_id\n directly, never this table.</color>
  MES --> [*] : status='REQUESTED'\n<color:#b00>NO WRITER. The live SOS\n machine is EmergencyRequest.</color>
  MP --> [*] : payment_status='pending'\n<color:#b00>NO WRITER</color>
  RF --> [*] : status='PENDING' + processed_at\n<color:#b00>ZERO write sites outside $fillable</color>
