  GP --> [*] : <color:#b00>NO WRITER</color>
  GI --> [*] : status='unpaid'\nONE writer: generateInvoice():191\n<color:#b00>No transition to paid/partial.\n Web\RepairController:247 calls the\n NON-EXISTENT RepairService::recordPayment()</color>
  RW --> [*] : status='active'\n<color:#b00>NEVER WRITTEN — read-only in\n Api\v1\WarrantyController</color>
}

